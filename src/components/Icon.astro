---
interface Props {
  name: 'search' | 'bag' | 'whatsapp' | 'back' | 'plus' | 'check' | 'expand';
  size?: number;
}
const { name, size = 22 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'search' && (<><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></>)}
  {name === 'bag' && (<><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></>)}
  {name === 'whatsapp' && (<><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z" /><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1.5-1.5-2-1-1 1c-1-.4-2.1-1.5-2.5-2.5l1-1-1-2L9 9.5z" /></>)}
  {name === 'back' && <path d="M15 5l-7 7 7 7" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'check' && <path d="M5 12l5 5 9-10" />}
  {name === 'expand' && <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />}
</svg>
