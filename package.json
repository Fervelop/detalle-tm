{
  "name": "detalle-tm",
  "version": "0.1.0",
  "description": "Tienda web de Detalle TM — detalles, decoraciones y floristería en Bogotá",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler pages dev",
    "check": "astro check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply detalle-tm --local",
    "db:migrate:remote": "wrangler d1 migrations apply detalle-tm --remote",
    "db:seed:local": "wrangler d1 execute detalle-tm --local --file=db/seed.sql",
    "db:seed:remote": "wrangler d1 execute detalle-tm --remote --file=db/seed.sql"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^4.4.2",
    "astro": "^5.18.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.162.0"
  },
  "private": true,
  "type": "module"
}
